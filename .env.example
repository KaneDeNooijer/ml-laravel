# Application
APP_NAME=LLMaaltijd
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5678

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MongoDB (no credentials are needed for the default local installation)
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=llmaaltijd

# Sessions, cache, and queues use simple local defaults. Their MongoDB
# alternatives are configured and can be selected with "mongodb".
SESSION_DRIVER=file
SESSION_CONNECTION=mongodb
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=mongodb
MONGODB_QUEUE=default
MONGODB_QUEUE_RETRY_AFTER=90

# Files and mail stay local during development.
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="llmaaltijd@localhost"
MAIL_FROM_NAME="${APP_NAME}"
